# Copy this file to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Dev iteration: Groq (free, fast). Demo/deploy build: Bedrock Converse.
# One of "groq" or "bedrock".
LLM_BACKEND=groq

# Groq (https://console.groq.com/keys) — used when LLM_BACKEND=groq
GROQ_API_KEY=
# Model ids used per node (cheap for extraction, stronger for nuance/drafting).
# Check your account's available models: `python -c "from groq import Groq; \
#   print([m.id for m in Groq().models.list().data])"`
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# --- AWS Bedrock -----------------------------------------------------------
# Used when LLM_BACKEND=bedrock and/or EMBEDDING_BACKEND=bedrock.
#
# Credentials: prefer an SSO profile that boto3 can auto-refresh —
#   set   AWS_PROFILE=<your-sso-profile>   and run `aws sso login` first,
#   and LEAVE the three key vars below blank/removed (explicit keys override
#   the profile). Pasting temporary SSO keys works too but they expire mid-demo.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#
# Claude 4.x/4.5 can't be invoked with the bare `anthropic.` id — use the
# `us.` cross-region inference profile prefix (works from us-east-1). Verify
# what your account can actually invoke with `python src/check_env.py`.
BEDROCK_EXTRACT_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REASONING_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Optional: DRAFT_MODEL_ROLE=extract runs drafting on the cheap model (only
# needed if the strong model is rate-limited; not on us-east-1).

# --- Embeddings (retrieval layer) ----------------------------------------
# "local"   = sentence-transformers/all-MiniLM-L6-v2 (384-dim, no keys, on-device)
# "bedrock" = BEDROCK_EMBED_MODEL below. Rebuild the index after switching
#             (dimensions differ): `python src/ingest.py`
EMBEDDING_BACKEND=local
# cohere.embed-english-v3 beats amazon.titan-embed-text-v2:0 on this corpus
# (recall@3 0.80 vs 0.50). Both are 1024-dim; rebuild the index after changing.
BEDROCK_EMBED_MODEL=cohere.embed-english-v3

# --- Agent guardrails ---------------------------------------------------
# Hard cap on orchestration loop iterations, enforced from state.
MAX_ITERATIONS=6
