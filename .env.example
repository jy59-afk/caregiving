# Copy this file to .env and fill in real values. .env is gitignored.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# Dev iteration: Groq (free, fast). Demo/deploy build: Bedrock Converse.
# One of "groq" or "bedrock".
LLM_BACKEND=groq

# Groq (https://console.groq.com/keys) — used when LLM_BACKEND=groq
GROQ_API_KEY=
# Model ids used per node (cheap for extraction, stronger for nuance/drafting).
GROQ_EXTRACT_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# --- AWS Bedrock -----------------------------------------------------------
# Used when LLM_BACKEND=bedrock and/or EMBEDDING_BACKEND=bedrock.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Bedrock model ids (Claude Haiku 4.5 for extraction/classification,
# Claude Sonnet 4.5 where matching nuance or drafting quality matters).
BEDROCK_EXTRACT_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REASONING_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Embeddings (retrieval layer) ----------------------------------------
# "local" = sentence-transformers/all-MiniLM-L6-v2 (no keys, runs on-device).
# "bedrock" = Amazon Titan Text Embeddings V2. Rebuild the index after switching.
EMBEDDING_BACKEND=local

# --- Agent guardrails ---------------------------------------------------
# Hard cap on orchestration loop iterations, enforced from state.
MAX_ITERATIONS=6
